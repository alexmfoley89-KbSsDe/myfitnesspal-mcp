{
  "name": "myfitnesspal-mcp",
  "version": "0.1.0",
  "description": "Remote MCP server exposing MyFitnessPal nutrition data — per-food diary, meal totals, macros/micros, water, exercise — to Claude for training coaching.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "icon": "node scripts/make-icon.mjs",
    "icon:embed": "node scripts/embed-icon.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.0.5",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agents": "^0.0.80",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8",
    "wrangler": "~4.99.0"
  }
}
